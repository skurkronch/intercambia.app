# Supabase (Project Settings → API). The anon / publishable key is public by design.
# Never put the service_role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "true" once Google is enabled in Supabase (Auth → Providers → Google).
NEXT_PUBLIC_AUTH_GOOGLE=

# Public URL once the domain points to Vercel. While empty, the site is not indexed.
NEXT_PUBLIC_SITE_URL=https://truxange.com

# Google AdSense (leave empty until the account is approved; a house ad shows instead)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_GRID=
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=
